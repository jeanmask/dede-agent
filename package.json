{
  "name": "dede-agent",
  "version": "1.0.0",
  "description": "Dede: The Design Doc Assistant. An autonomous agent for creating, reviewing, and governing Technical Design Docs.",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "release": "release-it",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 \"**/*.md\" --fix",
    "lint:yaml": "prettier --check \"**/*.{yml,yaml}\"",
    "lint:yaml:fix": "prettier --write \"**/*.{yml,yaml}\"",
    "validate:schema": "ajv validate -s templates/config.schema.json -d templates/config.yaml"
  },
  "lint-staged": {
    "**/*.md": [
      "markdownlint-cli2 --fix"
    ],
    "**/*.{yml,yaml}": [
      "prettier --write"
    ],
    "templates/config.yaml": [
      "ajv validate -s templates/config.schema.json -d"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@release-it/conventional-changelog": "^12.0.2",
    "ajv-cli": "^5.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "markdownlint-cli2": "^0.14.0",
    "prettier": "^3.0.0",
    "release-it": "^21.0.3"
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "default_profile": {
      "type": "string"
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "required_sections": { "type": "array" },
          "optional_sections": { "type": "array" },
          "ignored_sections": { "type": "array" }
        },
        "required": ["name", "description", "required_sections"]
      }
    },
    "custom_sections": {
      "type": "object"
    },
    "storage": {
      "type": "object",
      "properties": {
        "primary": { "type": "string" },
        "path": { "type": "string" }
      },
      "required": ["primary", "path"]
    },
    "publishing": {
      "type": "object",
      "properties": {
        "provider": { "type": "string" },
        "diagram_syntax": { "type": "string" },
        "target_auth": { "type": "object" }
      },
      "required": ["provider", "diagram_syntax"]
    }
  },
  "required": ["version", "default_profile", "profiles", "storage", "publishing"]
}
